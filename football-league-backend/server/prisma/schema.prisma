generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户模型（完整匹配seed字段）
model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique @db.VarChar(20)
  password    String   @db.VarChar(128)
  openid      String?  @unique @db.VarChar(50)
  focus_teams String?  @default("") @db.VarChar(255)
  score       Int      @default(0)
  avatar_url  String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系（必须和Team里的relation名称完全一致）
  collections UserCollection[]
  comments    Comment[]
  guesses     Guess[]
  focusTeams  Team[]    @relation("UserFocusTeams")

  @@map("users")
}

// 球队模型（无重复，完整匹配seed）
model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(20)
  city        String   @db.VarChar(20)
  logo_url    String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  homeMatches  Match[]    @relation("HomeTeam")
  awayMatches  Match[]    @relation("AwayTeam")
  players      Player[]
  lineupEntries MatchLineupEntry[]
  teamRankings TeamRanking[]
  standing     Standing?
  news         News[]
  focusUsers   User[]     @relation("UserFocusTeams")

  @@map("teams")
}

// 比赛模型（无重复，完整匹配seed）
model Match {
  id                   Int      @id @default(autoincrement())
  home_team_id         Int?
  away_team_id         Int?
  match_time           DateTime
  venue                String?  @db.VarChar(50)
  home_score           Int      @default(0)
  away_score           Int      @default(0)
  status               Int      @default(0) @db.SmallInt
  possession_rate_home Float?
  possession_rate_away Float?
  shot_count_home      Int?
  shot_count_away      Int?
  
  // 深度提取的技术统计
  attack_home          Int?
  attack_away          Int?
  dangerous_attack_home Int?
  dangerous_attack_away Int?
  shots_on_target_home Int?
  shots_on_target_away Int?
  shots_off_target_home Int?
  shots_off_target_away Int?
  corner_count_home    Int?
  corner_count_away    Int?
  penalty_count_home   Int?
  penalty_count_away   Int?
  yellow_card_home     Int?
  yellow_card_away     Int?
  red_card_home        Int?
  red_card_away        Int?

  // 首发阵容 (JSON 字符串)
  lineup_home          String?  @db.Text
  lineup_away          String?  @db.Text

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // 关联关系
  home_team       Team?            @relation("HomeTeam", fields: [home_team_id], references: [id], onDelete: SetNull)
  away_team       Team?            @relation("AwayTeam", fields: [away_team_id], references: [id], onDelete: SetNull)
  userCollections UserCollection[]
  comments        Comment[]
  votes           Vote[]
  guesses         Guess[]

  events          MatchEvent[]
  textLives       TextLive[]
  lineupEntries   MatchLineupEntry[]

  @@map("football_match")
}

// 文字直播模型
model TextLive {
  id         Int      @id @default(autoincrement())
  match_id   Int
  time       String   @db.VarChar(20) // 例如 "2025-06-08 17:42" 或者 "90'"
  content    String   @db.Text
  createdAt  DateTime @default(now())

  match      Match    @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@map("text_lives")
}

// 比赛事件模型（每分钟的比分变动、红黄牌进球流）
model MatchEvent {
  id         Int      @id @default(autoincrement())
  match_id   Int
  minute     String   @db.VarChar(10) // 例如 "15'", "90'+2"
  team_type  String   @db.VarChar(10) // "home" or "away"
  event_type String   @db.VarChar(20) // "goal", "yellow_card", "red_card"
  player     String   @db.VarChar(50)
  detail     String?  @db.VarChar(100) // 例如进球比分 "1-0" 
  createdAt  DateTime @default(now())

  match      Match    @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@map("match_events")
}

// 竞猜模型（核心修复：必须包含isCorrect字段，索引名和seed完全一致）
model Guess {
  id           Int      @id @default(autoincrement())
  user_id      Int
  match_id     Int
  guess_result String   @db.VarChar(10)
  score_cost   Int      @default(0)
  score_reward Int?
  status       Int      @default(0) @db.SmallInt
  isCorrect    Boolean? // 解决isCorrect不存在的核心字段
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联关系
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)

  // 复合唯一索引，名称必须和seed里的完全一致
  @@unique([user_id, match_id], name: "uk_user_match_guess")
  @@map("guesses")
}

// 球员模型
model Player {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(20)
  team_id       Int?
  position      String?  @db.VarChar(10)
  jersey_number Int?
  avatar_url    String?  @db.VarChar(500)
  external_source String? @db.VarChar(50)
  external_id   String?  @db.VarChar(100)
  is_coach      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team           Team?  @relation(fields: [team_id], references: [id], onDelete: SetNull)
  votes          Vote[]
  lineupEntries  MatchLineupEntry[]
  playerRankings PlayerRanking[]

  @@index([name, team_id], name: "idx_player_name_team")
  @@index([external_source, external_id], name: "idx_player_external")
}

// 单场比赛阵容明细：首发、替补、教练都走这张表
model MatchLineupEntry {
  id             Int      @id @default(autoincrement())
  match_id       Int
  team_id        Int?
  player_id      Int?
  side           String   @db.VarChar(10)
  role           String   @db.VarChar(20)
  position       String?  @db.VarChar(20)
  jersey_number  Int?
  formation      String?  @db.VarChar(20)
  display_order  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  match  Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [team_id], references: [id], onDelete: SetNull)
  player Player? @relation(fields: [player_id], references: [id], onDelete: SetNull)

  @@unique([match_id, side, role, player_id], name: "uk_match_side_role_player")
  @@index([match_id, side], name: "idx_lineup_match_side")
  @@map("match_lineup_entries")
}

// 球员分类榜：射手、黄牌、红牌、点球等
model PlayerRanking {
  id          Int      @id @default(autoincrement())
  season      String   @db.VarChar(10)
  category    String   @db.VarChar(30)
  rank        Int
  player_id   Int?
  player_name String   @db.VarChar(50)
  team_id     Int?
  team_name   String?  @db.VarChar(50)
  avatar_url  String?  @db.VarChar(500)
  value       Int      @default(0)
  source      String?  @db.VarChar(50)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  player Player? @relation(fields: [player_id], references: [id], onDelete: SetNull)

  @@unique([season, category, player_name, team_name], name: "uk_player_ranking_identity")
  @@index([season, category, rank], name: "idx_player_ranking_category")
  @@map("player_rankings")
}

// 球队分类榜：进球、失球、黄牌、红牌、点球、射门、射正、角球等
model TeamRanking {
  id        Int      @id @default(autoincrement())
  season    String   @db.VarChar(10)
  category  String   @db.VarChar(30)
  rank      Int
  team_id   Int?
  team_name String   @db.VarChar(50)
  value     Int      @default(0)
  source    String?  @db.VarChar(50)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  team Team? @relation(fields: [team_id], references: [id], onDelete: SetNull)

  @@unique([season, category, team_name], name: "uk_team_ranking_identity")
  @@index([season, category, rank], name: "idx_team_ranking_category")
  @@map("team_rankings")
}

// 积分榜模型
model Standing {
  id        Int      @id @default(autoincrement())
  team_id   Int      @unique
  wins      Int      @default(0)
  draws     Int      @default(0)
  losses    Int      @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
}

// 用户收藏模型
model UserCollection {
  id        Int      @id @default(autoincrement())
  user_id   Int
  match_id  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@unique([user_id, match_id], name: "uk_user_match")
  @@map("user_collection")
}

// 评论模型
model Comment {
  id            Int      @id @default(autoincrement())
  user_id       Int?
  match_id      Int
  content       String   @db.VarChar(500)
  user_nickname String?  @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)
}

// 投票模型
model Vote {
  id         Int      @id @default(autoincrement())
  match_id   Int
  player_id  Int?
  vote_count Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  match  Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [player_id], references: [id], onDelete: SetNull)

  @@unique([match_id, player_id], name: "uk_match_player")
}

// 新闻模型
model News {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(100)
  cover_url  String?  @db.VarChar(255)
  content    String   @db.Text
  team_id    Int?
  read_count Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team Team? @relation(fields: [team_id], references: [id], onDelete: SetNull)
}
